---
import "@fontsource-variable/cormorant-garamond";
import "@fontsource-variable/manrope";
import "@fontsource/pinyon-script";
import "../styles/tokens.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Internal pages (e.g. /styleguide) stay out of search. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} — ${site.tagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F8F4" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="paper min-h-dvh bg-background text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-3 focus:text-button focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>