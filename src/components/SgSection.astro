---
/**
 * Section wrapper for /styleguide only.
 */
interface Props {
  id: string;
  number: string;
  title: string;
  note?: string;
}

const { id, number, title, note } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-line py-12">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span class="font-mono text-caption text-accent-strong">{number}</span>
    <h2 class="text-title">{title}</h2>
  </div>
  {note && <p class="mt-3 max-w-2xl text-caption text-ink-muted">{note}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>