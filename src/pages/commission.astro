---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import { site, isPlaceholder } from "../config/site";

const steps = [
  {
    title: "Share your story",
    body: "Couple names, wedding date, colours you love, and the mood you want to remember.",
  },
  {
    title: "Art direction",
    body: "A sketch and a palette, agreed before any final painting begins.",
  },
  {
    title: "Design creation",
    body: "The artwork is painted, then refined with you over a small number of revisions.",
  },
  {
    title: "Digital keepsake",
    body: "A page that opens beautifully on a phone, plus image files you keep.",
  },
];

const included = [
  "Custom invitation artwork",
  "Couple names and wedding details",
  "A mobile-first keepsake page",
  "Image files you can print or share",
];

const notIncluded = [
  "RSVP tracking or guest lists",
  "QR check-in",
  "Live streaming",
  "Wedding-day operations",
];
---

<Base
  title="Commission"
  description="How a Harikita Studio commission works, from first message to digital keepsake."
>
  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.85fr] lg:gap-20">
      <div>
        <p class="text-eyebrow uppercase text-ink-muted">Commission</p>
        <h1 class="mt-5 text-hero">
          Begin your<br />
          <span class="font-script text-[1.12em] font-normal text-primary">personalized</span>
          invitation
        </h1>
        <p class="mt-6 max-w-lg text-body text-ink-muted">
          An inquiry starts a conversation, not a transaction. Tell us who you
          are; we will tell you honestly whether we are the right studio for it.
        </p>
        <p class="mt-6 text-caption text-ink-muted">
          {isPlaceholder(site.availability)
            ? "A small number of commissions each month, by choice."
            : site.availability}
        </p>
      </div>

      <div class="rounded-lg border border-line bg-surface p-6 shadow-soft sm:p-8">
        <p class="text-eyebrow uppercase text-ink-muted">Inquiry</p>
        <p class="mt-3 text-body">
          The form is not connected yet. It will be a short Tally form — names,
          date, colours, and a few lines about your story.
        </p>
        <ul class="mt-5 space-y-2 text-caption text-ink-muted">
          <li>Couple names</li>
          <li>Email or WhatsApp</li>
          <li>Wedding date or estimate</li>
          <li>Preferred colour nuance</li>
          <li>Preferred style</li>
          <li>Your story, and any references</li>
        </ul>
        <div class="mt-7">
          <Button href="/about" variant="secondary">Read about the studio</Button>
        </div>
      </div>
    </div>

    <ol class="mt-20 grid gap-x-8 gap-y-10 border-t border-line pt-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li>
            <p class="font-mono text-caption text-accent-strong">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h2 class="mt-2 font-serif text-xl">{step.title}</h2>
            <p class="mt-2 text-caption text-ink-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 grid gap-8 sm:grid-cols-2">
      <div class="rounded-lg bg-surface p-6 ring-1 ring-line">
        <p class="text-eyebrow uppercase text-ink-muted">What you receive</p>
        <ul class="mt-3 space-y-2 text-caption">
          {included.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-lg bg-surface p-6 ring-1 ring-line">
        <p class="text-eyebrow uppercase text-ink-muted">What we do not do</p>
        <ul class="mt-3 space-y-2 text-caption text-ink-muted">
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>