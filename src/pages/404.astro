---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---

<Base title="Not found" noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-6 py-24 text-center">
    <p class="text-eyebrow uppercase text-ink-muted">404</p>
    <h1 class="mt-4 text-title">This page was never painted</h1>
    <p class="mt-4 text-body text-ink-muted">
      The link is broken or the page has moved. The studio is still here.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/">Back to the studio</Button>
      <Button href="/portfolio" variant="secondary">View portfolio</Button>
    </div>
  </section>
</Base>