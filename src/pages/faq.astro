---
import Base from "../layouts/Base.astro";
import Stub from "../components/Stub.astro";
---

<Base
  title="FAQ"
  description="Common questions about personalized wedding invitation art and digital keepsakes."
>
  <Stub
    title="Questions, answered"
    lede="The ten questions from the project spec will be answered here in plain language. The important one is first: this studio makes art, not a wedding management system."
    items={[
      "Is this a physical invitation, or a digital one?",
      "Can the design be customized?",
      "Can we choose blue or pink colours?",
      "Can we request a personalized illustration?",
      "How long does the process take?",
      "Do we receive digital files we keep?",
      "Can the invitation be shared on a phone?",
      "Do you handle RSVP tracking? — No.",
      "Do you handle live streaming? — No.",
      "How do we start?",
    ]}
  />
</Base>